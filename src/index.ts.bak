type TrackDirection = '蜿ｳ' | '蟾ｦ';

const VENUE_DIRECTION_MAP: Record<string, { default: TrackDirection; exceptions?: { distance: number; direction: TrackDirection }[] }> = {
  '譛ｭ蟷・: { default: '蜿ｳ' },
  '蜃ｽ鬢ｨ': { default: '蜿ｳ' },
  '遖丞ｳｶ': { default: '蜿ｳ' },
  '譁ｰ貎・: {
    default: '蟾ｦ',
    exceptions: [{ distance: 1000, direction: '蜿ｳ' }],
  },
  '譚ｱ莠ｬ': { default: '蟾ｦ' },
  '荳ｭ螻ｱ': { default: '蜿ｳ' },
  '荳ｭ莠ｬ': { default: '蟾ｦ' },
  '莠ｬ驛ｽ': { default: '蜿ｳ' },
  '髦ｪ逾・: { default: '蜿ｳ' },
  '蟆丞・: { default: '蜿ｳ' },
};

function inferDirectionByVenueAndDistance(venue?: string | null, distance?: number | null): TrackDirection {
  const trimmedVenue = typeof venue === 'string' ? venue.trim() : '';
  const config = trimmedVenue ? VENUE_DIRECTION_MAP[trimmedVenue] : undefined;
  const distanceNumber = typeof distance === 'number' ? distance : Number(distance);
  if (config) {
    if (Number.isFinite(distanceNumber) && config.exceptions) {
      for (const exception of config.exceptions) {
        if (exception.distance === distanceNumber) {
          return exception.direction;
        }
      }
    }
    return config.default;
  }
  if (Number.isFinite(distanceNumber) && distanceNumber >= 2000) {
    return '蟾ｦ';
  }
  return '蜿ｳ';
}

function resolveDirection(rawDirection: unknown, venue?: string | null, distance?: number | null): TrackDirection {
  const inferred = inferDirectionByVenueAndDistance(venue, distance);
  if (rawDirection === '蜿ｳ' || rawDirection === '蟾ｦ') {
    if (inferred !== rawDirection) {
      return inferred;
    }
    return rawDirection;
  }
  return inferred;
}



// 繝ｬ繝ｼ繧ｹ蜷阪°繧峨け繝ｩ繧ｹ諠・ｱ繧呈歓蜃ｺ縺吶ｋ髢｢謨ｰ
function extractClassFromRaceName(raceName: string): string {
  if (!raceName) return '-';

  // 譁ｰ鬥ｬ繝ｻ譛ｪ蜍晏茜
  if (raceName.includes('譁ｰ鬥ｬ')) return '譁ｰ鬥ｬ';
  if (raceName.includes('譛ｪ蜍晏茜')) return '譛ｪ蜍晏茜';

  // 蜍晏茜繧ｯ繝ｩ繧ｹ
  if (raceName.includes('・大享') || raceName.includes('1蜍・)) return '1蜍昴け繝ｩ繧ｹ';
  if (raceName.includes('・貞享') || raceName.includes('2蜍・)) return '2蜍昴け繝ｩ繧ｹ';
  if (raceName.includes('・灘享') || raceName.includes('3蜍・)) return '3蜍昴け繝ｩ繧ｹ';

  // 繧ｪ繝ｼ繝励Φ繝ｻ驥崎ｳ・
  if (raceName.includes('繧ｪ繝ｼ繝励Φ') || raceName.includes('OP')) return '繧ｪ繝ｼ繝励Φ';
  if (raceName.includes('・ｧ・・) || raceName.includes('G1')) return 'G1';
  if (raceName.includes('・ｧ・・) || raceName.includes('G2')) return 'G2';
  if (raceName.includes('・ｧ・・) || raceName.includes('G3')) return 'G3';

  // 迚ｹ蛻･繝ｻ譚｡莉ｶ謌ｦ
  if (raceName.includes('迚ｹ蛻･')) return '迚ｹ蛻･';
  if (raceName.includes('譚｡莉ｶ')) return '譚｡莉ｶ謌ｦ';

  // 繝・ヵ繧ｩ繝ｫ繝・
  return '譚｡莉ｶ謌ｦ';
}

type EntryForDedup = {
  id: number;
  horseId: string | null;
  horseNo: number | null;
};

export function resolveDuplicateRaceEntryIds(entries: EntryForDedup[]): number[] {
  const seen = new Map<string, EntryForDedup>();
  const duplicates: number[] = [];

  for (const entry of entries) {
    if (!entry.horseId) continue;

    const currentNo = entry.horseNo ?? 0;
    const existing = seen.get(entry.horseId);

    if (!existing) {
      seen.set(entry.horseId, entry);
      continue;
    }

    const existingNo = existing.horseNo ?? 0;

    if (existingNo === 0 && currentNo !== 0) {
      duplicates.push(existing.id);
      seen.set(entry.horseId, entry);
    } else if (currentNo === 0 && existingNo !== 0) {
      duplicates.push(entry.id);
    } else {
      duplicates.push(entry.id);
    }
  }

  return duplicates;
}

